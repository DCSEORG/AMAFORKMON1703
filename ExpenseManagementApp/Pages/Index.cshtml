@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>⚠️ Database Connection Error:</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 fw-bold text-primary">💼 Expense Management</h1>
            <p class="lead text-muted">Track and manage your business expenses</p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Expenses</h6>
                            <h3 class="mb-0">@Model.Expenses.Count</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <span class="fs-4">📊</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Submitted</h6>
                            <h3 class="mb-0">@Model.Expenses.Count(e => e.StatusName == "Submitted")</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                            <span class="fs-4">⏳</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Approved</h6>
                            <h3 class="mb-0">@Model.Expenses.Count(e => e.StatusName == "Approved")</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <span class="fs-4">✅</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Amount</h6>
                            <h3 class="mb-0">£@Model.Expenses.Sum(e => e.AmountDecimal).ToString("N2")</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3">
                            <span class="fs-4">💰</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="row mb-3">
        <div class="col-md-8">
            <form method="get" class="row g-2">
                <div class="col-auto">
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var status in Model.Statuses)
                        {
                            <option value="@status.StatusId" selected="@(Model.StatusFilter == status.StatusId)">
                                @status.StatusName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Filter</button>
                </div>
                @if (Model.StatusFilter.HasValue)
                {
                    <div class="col-auto">
                        <a asp-page="/Index" class="btn btn-outline-secondary">Clear Filter</a>
                    </div>
                }
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="/Chat/Chat" class="btn btn-outline-success me-2">🤖 AI Chat</a>
            <a href="/swagger" class="btn btn-outline-info me-2" target="_blank">📚 API Docs</a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createExpenseModal">
                ➕ New Expense
            </button>
        </div>
    </div>

    <!-- Expenses Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td><strong>#@expense.ExpenseId</strong></td>
                                <td>
                                    <div>
                                        <div class="fw-bold">@expense.UserName</div>
                                        <small class="text-muted">@expense.Email</small>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@expense.CategoryName</span></td>
                                <td class="fw-bold text-success">£@expense.AmountDecimal.ToString("N2")</td>
                                <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <small class="text-muted">
                                        @(string.IsNullOrEmpty(expense.Description) ? "-" : 
                                          expense.Description.Length > 50 ? expense.Description.Substring(0, 50) + "..." : expense.Description)
                                    </small>
                                </td>
                                <td>
                                    @if (expense.StatusName == "Draft")
                                    {
                                        <span class="badge bg-secondary">📝 @expense.StatusName</span>
                                    }
                                    else if (expense.StatusName == "Submitted")
                                    {
                                        <span class="badge bg-warning text-dark">⏳ @expense.StatusName</span>
                                    }
                                    else if (expense.StatusName == "Approved")
                                    {
                                        <span class="badge bg-success">✅ @expense.StatusName</span>
                                    }
                                    else if (expense.StatusName == "Rejected")
                                    {
                                        <span class="badge bg-danger">❌ @expense.StatusName</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @if (expense.StatusName == "Draft")
                                        {
                                            <form method="post" asp-page-handler="Submit" class="d-inline">
                                                <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                                <button type="submit" class="btn btn-outline-primary">Submit</button>
                                            </form>
                                        }
                                        @if (expense.StatusName == "Submitted")
                                        {
                                            <form method="post" asp-page-handler="Approve" class="d-inline me-1">
                                                <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                                <button type="submit" class="btn btn-outline-success">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="Reject" class="d-inline">
                                                <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                                <button type="submit" class="btn btn-outline-danger">Reject</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Expenses.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted">No expenses found. Create one to get started!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Expense Modal -->
<div class="modal fade" id="createExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select" required>
                            <option value="">Select Category</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount (£)</label>
                        <input type="number" name="amount" class="form-control" step="0.01" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Expense Date</label>
                        <input type="date" name="expenseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                    <input type="hidden" name="userId" value="1" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>
